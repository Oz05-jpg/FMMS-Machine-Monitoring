@model FMMSMachineMonitoring.Models.DashboardViewModel
<h1>FMMS Dashboard</h1>
@foreach (var machine in Model.Machines)
{
    <div class="machine-card">
        <h2>@machine.Name (@machine.Code)</h2>
        <p>Model: @machine.Model</p>
        <p>Location: @machine.Location</p>
        <p>Install Date: @machine.InstallDate.ToShortDateString()</p>
        <p>Status: @machine.Status</p>
    </div>
}

<table class="table ">
    <thead>
        <tr>
            <th>Urgency</th>
            <th>Count</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.OpenWorkOrderCounts)
        {
            <tr>
                <td>@item.Key</td>
                <td>@item.Value</td>
            </tr>
        }
        
    </tbody>
    
</table> 
<table class ="table">
    <thead>
        <tr>
            <th>Machine</th>
            <th>MTTR(Hours)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.MttrByMachine)
        {
            <tr>
                <td>@item.MachineCode</td>
                <td>@item.MttrHours.ToString("0.0")</td>
            </tr>
        }
    </tbody>
</table>
<p class="text-muted small">MTTR นับจากเปิดใบงานถึงปิดใบงาน (รวมเวลารอช่าง)</p>

<canvas id="mttrChart" width="400" height="200"></canvas>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
        <script>
            const labels = @Html.Raw(Json.Serialize(Model.MttrByMachine.Select(m => m.MachineCode)));
            const values = @Html.Raw(Json.Serialize(Model.MttrByMachine.Select(m => m.MttrHours)));
        new Chart(document.getElementById('mttrChart'), {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'MTTR (Hours)',
                    data: values,
                    backgroundColor: 'rgba(54, 162, 235, 0.2)',
                    borderColor: 'rgba(54, 162, 235, 1)',
                    borderWidth: 1
                }]
            },
            options: {
                scales: {
                    y: { title: { display: true, text: 'MTTR (Hours)' }
                }
            }
        });
        </script>
}